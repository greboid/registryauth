{{- /*gotype: github.com/greboid/registryauth/listing.RepositoryDetails*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:;base64,=">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/css">
    <script defer src="/js"></script>
</head>
<body>
{{ template "session" .Session }}
<section>
    <h1>{{.Title}}/{{.Repository.Name}}</h1>
    <p><a href="/">All repositories</a></p>
    <table>
        <thead>
        <tr>
            <th>Tag</th>
            <th>Pull</th>
            <th>Digest</th>
            <th>Size</th>
        </tr>
        </thead>
        <tbody>
        {{ range .Repository.Tags }}
            <tr>
                <td>{{ .Name }}</td>
                <td>
                    <code class="ref">{{ $.Title }}/{{ $.Repository.Name }}:{{ .Name }}</code>
                    <span class="copy" data-ref="{{ $.Title }}/{{ $.Repository.Name }}:{{ .Name }}">📋</span>
                </td>
                <td>
                    <span class="sha" title="{{ .SHA }}">{{ ShortDigest .SHA }}</span>
                    {{ if ne .SHA "error" }}<span class="copy" data-ref="{{ $.Title }}/{{ $.Repository.Name }}@{{ .SHA }}">📋</span>{{ end }}
                </td>
                <td>{{ .Size | HumanSize }}</td>
            </tr>
        {{ else }}
            <tr>
                <td colspan="4">No Tags</td>
            </tr>
        {{ end }}
        </tbody>
    </table>
</section>
<footer>
    <p>Last polled: {{ DisplayTime .LastPolled }}</p>
</footer>
</body>
</html>
